TIMESCALE_HOST=timescale
TIMESCALE_PORT=5432
TIMESCALE_DATABASE=clashking
TIMESCALE_USERNAME=clashking
TIMESCALE_PASSWORD=replace_me
TIMESCALE_SSLMODE=disable

VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=replace_me

# Local Compose publishing only; keep both databases off public interfaces.
HOST_BIND_IP=127.0.0.1

ELASTIC_PASSWORD=

PGSYNC_BOOTSTRAP_DB_USER=
PGSYNC_BOOTSTRAP_DB_PASSWORD=

# PGSync runtime variables. In Coolify, point these directly at shared server
# variables instead of duplicating the source variable names in the service.
PG_DRIVER=psycopg2
PG_HOST=timescale
PG_PORT=5432
POSTGRES_DB=clashking
PG_USER=pgsync
PG_PASSWORD=replace_me
PG_SSLMODE=disable
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_API_KEY_ID=
ELASTICSEARCH_API_KEY=
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_AUTH=replace_me
